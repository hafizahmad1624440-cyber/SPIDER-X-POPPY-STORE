
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SPIDER X POPY STORE</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #090909;
  color: white;
  font-family: Arial, sans-serif;
}

header {
  background: #160000;
  padding: 25px 12px;
  text-align: center;
  border-bottom: 2px solid red;
}

header h1 {
  color: #ff2525;
  font-size: 27px;
}

header p {
  color: #ccc;
  margin-top: 8px;
}

nav {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20px;
  padding: 15px;
  background: #171717;
}

nav a {
  color: white;
  text-decoration: none;
  font-weight: bold;
}

nav a:hover {
  color: red;
}

.hero {
  text-align: center;
  padding: 65px 15px;
  background: linear-gradient(120deg,#300000,#080808);
}

.hero h2 {
  font-size: 32px;
  color: red;
}

.hero p {
  margin: 15px;
  color: #ddd;
}

.hero button {
  background: red;
  color: white;
  padding: 13px 25px;
  border: none;
  border-radius: 6px;
  font-weight: bold;
  cursor: pointer;
}

.section-title {
  text-align: center;
  margin: 35px 0 20px;
  color: red;
}

.products {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
  gap: 20px;
  padding: 20px;
}

.card {
  background: #191919;
  border: 1px solid #393939;
  border-radius: 12px;
  overflow: hidden;
  text-align: center;
  padding-bottom: 20px;
}

.card img {
  width: 100%;
  height: 155px;
  object-fit: cover;
}

.card h3 {
  margin: 15px 5px 8px;
}

.price {
  color: #ff3030;
  font-size: 21px;
  font-weight: bold;
  margin: 12px;
}

.card button {
  background: #e60000;
  color: white;
  padding: 11px 22px;
  border: none;
  border-radius: 6px;
  cursor: pointer;
}

.card button:hover {
  background: #a00000;
}

footer {
  background: #171717;
  text-align: center;
  padding: 25px;
  margin-top: 30px;
  color: #aaa;
}

footer h3 {
  color: red;
  margin-bottom: 10px;
}
</style>
</head>

<body>

<header>
  <h1>SPIDER X POPY STORE</h1>
  <p>Car Parking Multiplayer Official Fan Store</p>
</header>

<nav>
  <a href="#home">Home</a>
  <a href="#cars">Cars</a>
  <a href="#accounts">Accounts</a>
  <a href="#money">Money & Coins</a>
  <a href="#contact">Contact</a>
</nav>

<section class="hero" id="home">
  <h2>WELCOME TO SPIDER X POPY</h2>
  <p>Find Your Favourite CPM Cars & Custom Designs!</p>
  <button onclick="document.getElementById('cars').scrollIntoView({behavior:'smooth'})">
    SHOP NOW
  </button>
</section>

<h2 class="section-title" id="cars">🔥 CPM CARS</h2>

<div class="products">

  <div class="card">
    <img src="https://placehold.co/500x300/191919/ffffff?text=BMW+M4" alt="BMW M4">
    <h3>BMW M4</h3>
    <p class="price">Rs. 120</p>
    <button onclick="order('BMW M4',120)">Order Now</button>
  </div>

  <div class="card">
    <img src="https://placehold.co/500x300/191919/ffffff?text=Fortuner" alt="Fortuner">
    <h3>Fortuner</h3>
    <p class="price">Rs. 100</p>
    <button onclick="order('Fortuner',100)">Order Now</button>
  </div>

  <div class="card">
    <img src="https://placehold.co/500x300/191919/ffffff?text=Ferrari" alt="Ferrari">
    <h3>Ferrari</h3>
    <p class="price">Rs. 70</p>
    <button onclick="order('Ferrari',70)">Order Now</button>
  </div>

  <div class="card">
    <img src="https://placehold.co/500x300/191919/ffffff?text=Lamborghini" alt="Lamborghini">
    <h3>Lamborghini</h3>
    <p class="price">Rs. 100</p>
    <button onclick="order('Lamborghini',100)">Order Now</button>
  </div>

</div>

<h2 class="section-title" id="accounts">👑 CPM ACCOUNTS</h2>

<div class="products">
  <div class="card">
    <img src="https://placehold.co/500x300/191919/ffffff?text=MAX+ACCOUNT" alt="Max account">
    <h3>MAX ACCOUNT</h3>
    <p class="price">Rs. 200</p>
    <button onclick="order('MAX ACCOUNT',200)">Order Now</button>
  </div>
</div>

<h2 class="section-title" id="money">💰 MONEY & COINS</h2>

<div class="products">
  <div class="card">
    <img src="https://placehold.co/500x300/191919/ffffff?text=MAX+MONEY" alt="Max money">
    <h3>MAX MONEY</h3>
    <p class="price">Rs. 50</p>
    <button onclick="order('MAX MONEY',50)">Order Now</button>
  </div>

  <div class="card">
    <img src="https://placehold.co/500x300/191919/ffffff?text=MAX+COINS" alt="Max coins">
    <h3>MAX COINS</h3>
    <p class="price">Rs. 100</p>
    <button onclick="order('MAX COINS',100)">Order Now</button>
  </div>
</div>

<footer id="contact">
  <h3>SPIDER X POPY STORE</h3>
  <p>Thank you for visiting our store!</p>
  <p>Order through WhatsApp</p>
</footer>

<script>
const whatsappNumber = "03436600980";

function order(product, price) {
  const message = `Hello SPIDER X POPY STORE! I want to order ${product} for Rs. ${price}.`;
  const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
  window.open(url, "_blank");
}
</script>

</body>
</html>
